# ==============================================================================
# Almanac Configuration
# ==============================================================================

# AI Provider: 'gemini', 'openai', 'openrouter', or 'mock'
AI_PROVIDER=openrouter

# Optional model override (leave blank to use provider default)
# Examples:
#   Gemini: gemini-2.5-flash, gemini-2.5-pro
#   OpenAI: gpt-4o-mini, gpt-4o
#   OpenRouter: deepseek/deepseek-chat-v3, anthropic/claude-3.5-sonnet
AI_MODEL=

# Provider API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
